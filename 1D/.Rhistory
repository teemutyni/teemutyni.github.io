# Define the function u0
u0 = function(x1,x2){
exp(1i*k*(theta[1]*x1+theta[2]*x2))
}
testFn0 = function(x) {#x is vector which can be indexed x[1],x[2],...
#prod(cos(x))
#cos(x[1])*cos(x[2])
Re(exp(1i*k*(theta[1]*x[1]+theta[2]*x[2])) )
}
testFn1 = function(y) {
Re(BesselH(1, y+0i, 0)) # HOX! +0i crucial to get correct complex results!!
}
u0mat = outer(x1,x2, u0); # matrix of u0 values at x1,x2
filled.contour(x1,x2,Re(u0mat)) # plot real part of u0
